__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/
runs/
# Adversarial-evaluation output, same reasoning as the training corpora below: what is
# worth committing is the command that regenerates the run, not the ~14MB it emits.
runs-adv/
data/synthetic/
# Generated training corpora. Determined entirely by the seed and the config in
# scripts/build_training_corpus.py, so the reproducible artefact is that command,
# not the ~1GB of scan documents it emits.
data/synthetic-*/
build/
dist/
.venv/
*.parquet
# generated sites and reports
site/
site-demo/
*.report.html
# secrets: .env.example is the committed template
.env
.env.*
!.env.example
# Paper and design documents are kept locally, not in the repository: the code is the deliverable.
docs/
GAP_TRACEABILITY.md
*.docx
# Scripts that rewrite those documents.
scripts/update_docs*.py
scripts/*paper*.py
# Run outputs of any kind (runs/ and runs-adv/ are listed above).
runs-*/
# Model weights. The shipped default ranker is the one exception: it is what a fresh clone
# ranks a single real scan with, so it stays tracked.
*.ubj
*.pkl
*.joblib
*.pt
*.onnx
*.safetensors
!src/vulnpriority/rank/models/lambdamart.ubj
# Local editor/agent settings.
.claude/
